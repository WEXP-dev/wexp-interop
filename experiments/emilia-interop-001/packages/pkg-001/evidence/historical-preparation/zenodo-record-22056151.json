{"created": "2026-08-22T10:45:33.402950+00:00", "modified": "2026-08-22T10:45:33.653464+00:00", "id": 22056151, "conceptrecid": "22056150", "doi": "10.5281/zenodo.22056151", "conceptdoi": "10.5281/zenodo.22056150", "doi_url": "https://doi.org/10.5281/zenodo.22056151", "metadata": {"title": "WEXP \u00d7 EMILIA INTEROP-001", "doi": "10.5281/zenodo.22056151", "publication_date": "2026-08-22", "description": "<p>WEXP &times; EMILIA INTEROP-001 is an Experimental Interoperability Record documenting a controlled interoperability experiment using independently frozen readings and expectations over shared byte-identical fixtures. A controlled positive/hostile pair reproduced EMILIA&rsquo;s frozen distinction: P was reconciled / in_bounds, while P-1&mdash;differing only by removal of the meter-observation-to-action CAID binding plus the derivative signature update&mdash;was indeterminate / null with outcome_observations_not_exactly_bound. WEXP remained underdetermined for both fixtures because the frozen public WEXP surface provides no EP&rarr;WEXP mapping sufficient to construct the required Core AppraisalInput. The terminal result is Branch A &mdash; Explicit Bridge Required. No genuine semantic disagreement was established. This record does not claim full interoperability, conformance, mutual validation, semantic equivalence, physical truth, positive WEXP appraisal, IETF approval, or a normative EP&rarr;WEXP mapping.</p>", "access_right": "open", "creators": [{"name": "Sergeev, Mikhail", "affiliation": null, "orcid": "0009-0001-6443-855X"}, {"name": "Schrock, Iman", "affiliation": "EMILIA Protocol, Inc.", "orcid": "0009-0004-0290-5433"}], "keywords": ["WEXP", "Witnessability", "EMILIA", "interoperability", "witnessed execution", "agent protocols", "verification"], "related_identifiers": [{"identifier": "https://github.com/WEXP-dev/wexp-interop/releases/tag/wexp-emilia-interop-001", "relation": "isSupplementedBy", "resource_type": "other", "scheme": "url"}], "version": "001", "language": "eng", "resource_type": {"title": "Other", "type": "other"}, "license": {"id": "apache2.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "22056150"}}]}}, "title": "WEXP \u00d7 EMILIA INTEROP-001", "links": {"self": "https://zenodo.org/api/records/22056151", "self_html": "https://zenodo.org/records/22056151", "preview_html": "https://zenodo.org/records/22056151?preview=1", "doi": "https://doi.org/10.5281/zenodo.22056151", "self_doi": "https://doi.org/10.5281/zenodo.22056151", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.22056151", "reserve_doi": "https://zenodo.org/api/records/22056151/draft/pids/doi", "parent": "https://zenodo.org/api/records/22056150", "parent_html": "https://zenodo.org/records/22056150", "parent_doi": "https://doi.org/10.5281/zenodo.22056150", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.22056150", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:22056151/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:22056151/sequence/default", "files": "https://zenodo.org/api/records/22056151/files", "media_files": "https://zenodo.org/api/records/22056151/media-files", "latest": "https://zenodo.org/api/records/22056151/versions/latest", "latest_html": "https://zenodo.org/records/22056151/latest", "versions": "https://zenodo.org/api/records/22056151/versions", "draft": "https://zenodo.org/api/records/22056151/draft", "access_links": "https://zenodo.org/api/records/22056151/access/links", "access_grants": "https://zenodo.org/api/records/22056151/access/grants", "access_users": "https://zenodo.org/api/records/22056151/access/users", "access_request": "https://zenodo.org/api/records/22056151/access/request", "access": "https://zenodo.org/api/records/22056151/access", "communities": "https://zenodo.org/api/records/22056151/communities", "communities-suggestions": "https://zenodo.org/api/records/22056151/communities-suggestions", "request_del