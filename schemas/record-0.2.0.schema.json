{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WEXP-dev/wexp-interop/blob/main/schemas/record-0.2.0.schema.json",
  "title": "WEXP interoperability collection package card 0.2.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "record_revision": {
      "type": "integer",
      "minimum": 1
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "package_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^pkg-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "object",
      "properties": {
        "integrity": {
          "enum": [
            "verified",
            "not-verified"
          ]
        },
        "execution": {
          "enum": [
            "archived-evidence-replayed",
            "local-run-completed",
            "not-run"
          ]
        },
        "independent_reproduction": {
          "enum": [
            "not-performed",
            "performed"
          ]
        },
        "comparison": {
          "enum": [
            "explicit-bridge-required",
            "no-local-decision-difference",
            "not-evaluated"
          ]
        },
        "publication": {
          "enum": [
            "prepared",
            "published"
          ]
        }
      },
      "required": [
        "integrity",
        "execution",
        "independent_reproduction",
        "comparison",
        "publication"
      ],
      "additionalProperties": false
    },
    "publication": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "minLength": 1,
          "format": "date"
        },
        "carriers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "zenodo",
                  "github-release",
                  "github-commit"
                ]
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "format": "uri"
              },
              "identifier": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "url",
              "identifier"
            ],
            "additionalProperties": false
          }
        },
        "version_doi": {
          "type": "string",
          "minLength": 1,
          "pattern": "^10\\.\\d{4,9}/\\S+$"
        },
        "concept_doi": {
          "type": "string",
          "minLength": 1,
          "pattern": "^10\\.\\d{4,9}/\\S+$"
        }
      },
      "required": [
        "version",
        "carriers"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\r\\n]+$"
        },
        "format": {
          "const": "zip"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_url": {
          "type": "string",
          "minLength": 1,
          "format": "uri"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "format",
        "bytes",
        "sha256",
        "source_url",
        "role"
      ],
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\r\\n]+$"
        },
        "role": {
          "enum": [
            "verified-extraction",
            "frozen-run-package"
          ]
        },
        "regular_files": {
          "type": "integer",
          "minimum": 1
        },
        "archive_container_metadata_preserved_in_git": {
          "const": false
        },
        "mode_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "role",
        "regular_files",
        "archive_container_metadata_preserved_in_git",
        "mode_note"
      ],
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "profile": {
          "enum": [
            "emilia-archive-v1",
            "aar-pilot-v1",
            "wimse-core02-migration-v1"
          ]
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\r\\n]+$"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\r\\n]+$"
          },
          "uniqueItems": true
        },
        "implementation_execution_performed": {
          "type": "boolean"
        }
      },
      "required": [
        "profile",
        "instructions",
        "evidence",
        "implementation_execution_performed"
      ],
      "additionalProperties": false
    },
    "independence": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\r\\n]+$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "scope",
        "method",
        "evidence"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "label",
        "details"
      ],
      "additionalProperties": false
    },
    "source_pins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "format": "uri"
          },
          "identity": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "title",
          "url",
          "identity",
          "scope"
        ],
        "additionalProperties": false
      }
    },
    "license": {
      "type": "object",
      "properties": {
        "scope_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\r\\n]+$"
        },
        "historical_artifact_license": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "scope_path",
        "historical_artifact_license"
      ],
      "additionalProperties": false
    },
    "citation_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\r\\n]+$"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "record_revision",
    "experiment_id",
    "package_id",
    "title",
    "summary",
    "status",
    "publication",
    "artifact",
    "payload",
    "verification",
    "independence",
    "result",
    "source_pins",
    "license",
    "citation_path",
    "limitations"
  ],
  "additionalProperties": false
}
